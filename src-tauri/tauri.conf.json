{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Classroom 50 Toolbox",
  "version": "../package.json",
  "identifier": "io.github.romainantunes.classroom50-toolbox",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Classroom 50 Toolbox",
        "url": "/",
        "width": 380,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "Education",
    "shortDescription": "Tray toolbox for Classroom 50 students",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "publisher": "Romain Antunes",
    "copyright": "Copyright © 2026 Romain Antunes",
    "homepage": "https://github.com/RomainAntunes/classroom50-toolbox",
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzRjEzQzQ0OTIwQzQ3MjUKUldRbFJ3eVNSRHp4a3dFVGxtemJrbTZYd05qZFo4Vmp3RUZjWkk0ZjJrUDRUR2FGeitHTndNSHIK",
      "endpoints": [
        "https://github.com/RomainAntunes/classroom50-toolbox/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "classroom50-toolbox"
}
