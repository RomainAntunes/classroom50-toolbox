{
  "name": "classroom50-toolbox",
  "version": "0.14.1-beta.1",
  "description": "Tray toolbox for Classroom 50 students",
  "author": "Romain Antunes (https://github.com/RomainAntunes)",
  "license": "GPL-3.0-only",
  "repository": "github:RomainAntunes/classroom50-toolbox",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "format": "prettier --write .",
    "lint": "prettier --check . && pnpm check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --headed --debug",
    "e2e:shots": "playwright test --config tests/e2e/shots.config.ts",
    "site:shots": "playwright test --config tests/e2e/showcase.config.ts",
    "bump": "node scripts/bump-version.mjs",
    "profile:power": "scripts/profile-power/capture.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "~2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "~2.5.0",
    "@tauri-apps/plugin-dialog": "~2.8.2",
    "@tauri-apps/plugin-log": "~2.10.1",
    "@tauri-apps/plugin-notification": "~2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.4"
  },
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
