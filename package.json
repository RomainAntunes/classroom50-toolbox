{
  "name": "classroom50-toolbox",
  "version": "0.7.2",
  "description": "Tray toolbox for Classroom 50 students",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "format": "prettier --write .",
    "lint": "prettier --check . && pnpm check",
    "test": "vitest run",
    "bump": "node scripts/bump-version.mjs"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "~2.7.0",
    "@tauri-apps/plugin-dialog": "~2.8.2",
    "@tauri-apps/plugin-log": "~2.10.1",
    "@tauri-apps/plugin-notification": "~2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-positioner": "~2.4.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.13.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.4"
  },
  "private": true,
  "repository": "github:RomainAntunes/classroom50-toolbox",
  "packageManager": "pnpm@12.6.0"
}
